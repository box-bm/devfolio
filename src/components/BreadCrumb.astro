---
import { getLangFromUrl } from "@i18n/utils";
import { defaultLang } from "@i18n/langs";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const home = lang === defaultLang ? "/" : `/${lang}/`;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a href={home} class="breadcrumb-link">BoxDev</a>
    </li>
    {
      items.map((item) => (
        <li class="breadcrumb-item">
          <span class="breadcrumb-sep" aria-hidden="true">
            /
          </span>
          {item.href ? (
            <a href={item.href} class="breadcrumb-link">
              {item.label}
            </a>
          ) : (
            <span class="breadcrumb-current" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }
  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .breadcrumb-sep {
    color: var(--text-tertiary);
  }
  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .breadcrumb-link:hover {
    color: var(--pencil);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .breadcrumb-current {
    overflow: hidden;
    max-width: 40ch;
    color: var(--text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* small screens: the page title sits right below, so drop the repeat */
  @media (max-width: 600px) {
    .breadcrumb-item:has(.breadcrumb-current) {
      display: none;
    }
  }
</style>
