---
interface Props {
  type?: "Outlined" | "Default" | "Text" | "Icon";
  target?: "_self" | "_blank" | "_parent" | "_top";
  color?: string;
  id?: string;
  href?: string;
  ariaLabel?: string;
  magnetic?: boolean;
}

const {
  type = "Default",
  href,
  target = "_blank",
  color,
  id,
  ariaLabel,
  magnetic = false,
} = Astro.props;
---

<a
  id={id}
  target={target}
  href={href}
  style={color ? `color: ${color}` : undefined}
  aria-label={ariaLabel}
  data-magnetic={magnetic ? "0.25" : undefined}
  class:list={[
    "btn",
    type === "Default" && "btn-default",
    type === "Outlined" && "btn-outlined",
    type === "Text" && "btn-text",
    type === "Icon" && "btn-icon",
  ]}
>
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    position: relative;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .btn__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn:active {
    transform: translateY(1px);
  }

  /* Default: solid graphite */
  .btn-default {
    color: var(--on-ink);
    background: var(--ink);
    border: 2px solid var(--ink);
  }
  .btn-default:hover {
    background: var(--ink-hover);
    border-color: var(--ink-hover);
    box-shadow: var(--shadow-md);
  }

  /* Outlined: a pencil line */
  .btn-outlined {
    color: var(--text-primary);
    background: transparent;
    border: 2px solid var(--text-primary);
  }
  .btn-outlined:hover {
    color: var(--pencil);
    border-color: var(--pencil);
  }

  /* Text */
  .btn-text {
    background: transparent;
    color: var(--accent);
    padding-inline: 14px;
  }
  .btn-text:hover {
    background: var(--accent-soft);
  }

  /* Icon */
  .btn-icon {
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--line-strong);
  }
  .btn-icon:hover {
    color: var(--pencil);
    border-color: var(--pencil);
  }
</style>
