---
interface Props {
  type?: "Outlined" | "Default" | "Text" | "Icon";
  target?: "_self" | "_blank" | "_parent" | "_top";
  color?: string;
  id?: string;
  href?: string;
  ariaLabel?: string;
  magnetic?: boolean;
}

const {
  type = "Default",
  href,
  target = "_blank",
  color,
  id,
  ariaLabel,
  magnetic = false,
} = Astro.props;
---

<a
  id={id}
  target={target}
  href={href}
  style={color ? `color: ${color}` : undefined}
  aria-label={ariaLabel}
  data-magnetic={magnetic ? "0.25" : undefined}
  class:list={[
    "btn",
    type === "Default" && "btn-default",
    type === "Outlined" && "btn-outlined",
    type === "Text" && "btn-text",
    type === "Icon" && "btn-icon",
  ]}
>
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    position: relative;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--dur) var(--ease-spring),
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .btn__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* shine sweep */
  .btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      110deg,
      transparent 30%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    transition: transform 650ms var(--ease-out);
  }
  .btn:hover::before {
    transform: translateX(120%);
  }

  .btn:active {
    transform: scale(0.96);
  }

  /* Default — accent gradient + glow */
  .btn-default {
    color: var(--accent-contrast);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow:
      var(--shadow-md),
      0 8px 24px var(--accent-glow);
  }
  .btn-default:hover {
    transform: translateY(-2px);
    box-shadow:
      var(--shadow-lg),
      0 14px 36px var(--accent-glow);
  }

  /* Outlined — glass */
  .btn-outlined {
    color: var(--text-primary);
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
  }
  .btn-outlined:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  /* Text */
  .btn-text {
    background: transparent;
    color: var(--accent);
    padding-inline: 14px;
  }
  .btn-text:hover {
    background: var(--accent-soft);
  }
  .btn-text::before {
    display: none;
  }

  /* Icon — glass circle */
  .btn-icon {
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
    color: var(--text-secondary);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .btn-icon::before {
    display: none;
  }
  .btn-icon:hover {
    transform: translateY(-3px);
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
</style>
