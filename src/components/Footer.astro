---
import Logo from "@components/visuals/Logo.astro";
import PencilNote from "@components/visuals/PencilNote.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { defaultLang } from "@i18n/langs";
import { UiKey } from "@i18n/ui";
import { Github, Linkedin, Mail, Coffee } from "@lucide/astro";
import { email, githubProfile, linkedIn, buyMeACoffee } from "@constants";
import Button from "@components/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

// English is at `/`, Spanish at `/es/`
const base = lang === defaultLang ? "" : `/${lang}`;
---

<footer class="page-break">
  <div class="footer-inner">
    <div class="footer-brand">
      <Logo variant="footer" />
      <PencilNote arrow="none" class="footer-signoff"
        >{t(UiKey["footer.signoff"])}</PencilNote
      >
    </div>

    <nav class="footer-nav" aria-labelledby="footer-explore">
      <h2 class="footer-label" id="footer-explore">
        {t(UiKey["footer.explore"])}
      </h2>
      <a class="nav-link" href={`${base}/#work`}>{t(UiKey["nav.projects"])}</a>
      <a class="nav-link" href={`/${lang}/guides`}>{t(UiKey["nav.guides"])}</a>
      <a class="nav-link" href={`${base}/#about`}>{t(UiKey["nav.about"])}</a>
      <a class="nav-link" href={`/${lang}/legal`}>{t(UiKey["legal.title"])}</a>
    </nav>

    <div class="footer-social">
      <h2 class="footer-label">{t(UiKey["nav.contact"])}</h2>
      <div class="social-icons">
        <Button type="Icon" href={githubProfile} ariaLabel="GitHub"
          ><Github size={18} /></Button
        >
        <Button type="Icon" href={linkedIn} ariaLabel="LinkedIn"
          ><Linkedin size={18} /></Button
        >
        <Button type="Icon" href={`mailto:${email}`} ariaLabel="Send email"
          ><Mail size={18} /></Button
        >
      </div>
      <a
        href={buyMeACoffee}
        target="_blank"
        rel="noopener noreferrer"
        class="bmc-link"
      >
        <Coffee size={18} />{t(UiKey["footer.buyMeACoffee"])}
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {currentYear} BoxDev</span>
    <span>{t(UiKey["footer.builtWith"])}</span>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 2;
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px clamp(20px, 5vw, 40px) 40px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .footer-label {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--text-primary);
  }

  .footer-nav,
  .footer-social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .nav-link:hover {
    color: var(--pencil);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .social-icons {
    display: flex;
    gap: 8px;
  }

  /* Square, outlined: a pencil box, not a pill */
  .bmc-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 8px;
    padding: 8px 14px;
    border: 1.5px solid var(--text-primary);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--text-primary);
  }
  .bmc-link:hover {
    color: var(--pencil);
    border-color: var(--pencil);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px) 32px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-brand {
      grid-column: auto;
    }
    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
