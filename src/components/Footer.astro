---
import Logo from "@components/visuals/Logo.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { defaultLang } from "@i18n/langs";
import { UiKey } from "@i18n/ui";
import { Github, Linkedin, Mail, Coffee } from "@lucide/astro";
import { email, githubProfile, linkedIn } from "@constants";
import Button from "@components/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

// English is at `/`, Spanish at `/es/`
const base = lang === defaultLang ? "" : `/${lang}`;
---

<footer>
  <div class="footer-inner">
    <!-- Brand -->
    <div class="footer-brand">
      <Logo variant="footer" />
      <p class="brand-tagline">{t(UiKey["portfolio.hero.caption"])}</p>
    </div>

    <!-- Nav links -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <span class="footer-section-label">{t(UiKey["footer.explore"])}</span>
      <a class="nav-link" href={`${base}/#about`}>{t(UiKey["nav.about"])}</a>
      <a class="nav-link" href={`${base}/#projects`}
        >{t(UiKey["nav.projects"])}</a
      >
      <a class="nav-link" href={`${base}/guides`}>{t(UiKey["nav.guides"])}</a>
      <a class="nav-link" href={`${base}/legal`}>{t(UiKey["legal.title"])}</a>
    </nav>

    <!-- Social + BMaC -->
    <div class="footer-social">
      <span class="footer-section-label">{t(UiKey["nav.contact"])}</span>
      <div class="social-icons">
        <Button type="Icon" href={githubProfile} ariaLabel="GitHub"
          ><Github size={16} /></Button
        >
        <Button type="Icon" href={linkedIn} ariaLabel="LinkedIn"
          ><Linkedin size={16} /></Button
        >
        <Button type="Icon" href={`mailto:${email}`} ariaLabel="Send email"
          ><Mail size={16} /></Button
        >
      </div>
      <a
        href="https://www.buymeacoffee.com/boxdev"
        target="_blank"
        rel="noopener noreferrer"
        class="bmc-link"
      >
        <Coffee size={15} />Buy me a coffee
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <span>© {currentYear} BOXDEV</span>
    <span>{t(UiKey["footer.builtWith"])}</span>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px clamp(16px, 4vw, 28px);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .brand-tagline {
    font-size: 13.5px;
    color: var(--text-secondary) !important;
    line-height: 1.6;
    max-width: 34ch;
    margin: 0 !important;
  }

  /* Nav */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .nav-link {
    font-size: 13.5px;
    color: var(--text-secondary) !important;
  }
  .nav-link:hover {
    color: var(--text-primary) !important;
  }

  /* Social */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-section-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary) !important;
  }
  .social-icons {
    display: flex;
    gap: 8px;
  }

  /* BMaC */
  .bmc-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--text-secondary) !important;
    width: fit-content;
  }
  .bmc-link:hover {
    color: var(--text-primary) !important;
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 28px) 32px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-brand {
      grid-column: auto;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
