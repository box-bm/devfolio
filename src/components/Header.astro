---
import Logo from "@components/visuals/Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "@components/LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { ArrowLeft } from "@lucide/astro";

interface Props {
  hideMenu?: boolean;
}

const { hideMenu = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === "en" ? "" : `/${lang}`;
---

<header class="site-header" data-site-header>
  <div class="nav">
    <Logo />

    {
      hideMenu ? (
        <a class="back-link" href={`${base}/`}>
          <ArrowLeft size={15} />
          {t(UiKey["nav.backToPortfolio"])}
        </a>
      ) : (
        <div class="nav__end">
          <div class="nav__links">
            <slot name="link" />
          </div>

          <div class="nav__right">
            <LanguagePicker />
            <ThemeToggle />
            <button
              class="menu-btn"
              aria-label="Toggle menu"
              aria-expanded="false"
            >
              <span />
              <span />
            </button>
          </div>
        </div>
      )
    }
  </div>

  {
    !hideMenu && (
      <div class="mobile-menu">
        <div class="mobile-menu__links">
          <slot name="link" />
          <slot name="secondary-link" />
        </div>
      </div>
    )
  }
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2000;
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
  }
  .site-header.scrolled {
    background: var(--glass-bg);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border-bottom-color: var(--line);
  }

  .nav {
    max-width: 1200px;
    margin-inline: auto;
    padding: 14px clamp(16px, 4vw, 28px);
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back-link {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }
  .back-link:hover {
    color: var(--text-primary);
  }

  /* Hamburger */
  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 14px;
    height: 1px;
    margin-inline: auto;
    background: var(--text-secondary);
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur);
  }
  .menu-btn[aria-expanded="true"] span:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] span:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-bottom: 1px solid var(--line);
    background: var(--glass-bg-strong);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    padding: 8px clamp(16px, 4vw, 28px) 18px;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }

  @media (max-width: 720px) {
    .nav__links {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
  }
</style>

<style is:global>
  .header-link {
    font-size: 13.5px;
    color: var(--text-secondary);
    transition: color var(--dur) var(--ease-out);
  }
  .header-link:hover,
  .header-link.active {
    color: var(--text-primary);
  }
  .mobile-menu__links .header-link {
    padding: 10px 0;
    width: 100%;
  }
</style>

<script>
  function initHeaderMenu() {
    const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
    const menu = document.querySelector<HTMLElement>(".mobile-menu");
    if (!btn || !menu) return;

    const close = () => {
      menu.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    };

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        close();
      }
    });

    menu
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));
    window.addEventListener("resize", close);
  }

  document.addEventListener("astro:page-load", initHeaderMenu);
</script>
