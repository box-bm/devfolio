---
import Button from "@components/Button.astro";
import { ArrowUpRight, Github } from "@lucide/astro";
import Card from "@components/Card.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

interface Props {
  title: string;
  description: string;
  viewLink: string;
  codeLink: string;
  index: number;
  badge: string;
}

const { title, description, viewLink, codeLink, index, badge } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="project-card" data-card data-href={viewLink} data-reveal="scale">
  <Card pressable tilt>
    <div class="project-card-strip">
      <span>PROJECT {String(index).padStart(2, "0")}</span>
      <span class="project-card-badge">{badge}</span>
    </div>
    <div class="project-card-content">
      <div class="project-card-top">
        <h3 class="h4">{title}</h3>
        <span class="project-card-arrow"><ArrowUpRight size={20} /></span>
      </div>
      <p>{description}</p>
      <slot name="content" />
    </div>
    <div class="project-card-tech">
      <slot name="tech" />
    </div>
    <div class="project-card-actions">
      <Button type="Outlined" href={codeLink}>
        <Github size={18} />{t(UiKey["portfolio.projects.viewCode"])}
      </Button>
      <Button href={viewLink}
        >{t(UiKey["portfolio.projects.viewProject"])}</Button
      >
    </div>
  </Card>
</div>

<style>
  .project-card :global(.card) {
    overflow: hidden;
    padding: 0;
    gap: 0;
  }
  .project-card :global(.card__inner) {
    gap: 0;
  }

  .project-card-strip {
    position: relative;
    height: 132px;
    padding: 14px 16px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(150deg, var(--surface-2), transparent 70%),
      radial-gradient(
        240px circle at 80% 120%,
        var(--accent-glow),
        transparent 60%
      );
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }
  .project-card-badge {
    align-self: flex-end;
    color: var(--accent);
  }

  .project-card-content {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
    margin-bottom: 12px;
  }
  .project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .project-card-arrow {
    display: grid;
    place-items: center;
    color: var(--text-tertiary);
    transition:
      transform var(--dur) var(--ease-spring),
      color var(--dur) var(--ease-out);
  }
  .project-card:hover .project-card-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .project-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 22px;
    margin-bottom: 16px;
  }

  .project-card-actions {
    display: flex;
    gap: 8px;
    padding: 0 22px 22px;
  }
  .project-card-actions :global(.btn) {
    flex: 1;
  }
</style>

<script>
  function initProjectCards() {
    document.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
      const href = card.dataset.href;
      if (!href) return;
      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) return;
        window.open(href, "_blank");
      });
    });
  }
  document.addEventListener("astro:page-load", initProjectCards);
</script>
