---
interface Props {
  title: string;
  description: string;
  lang?: string;
  type?: "website" | "article";
  date?: Date;
  updatedDate?: Date;
}

const { title, description, lang = "en", type = "website", date, updatedDate } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const locale = lang === "es" ? "es_GT" : "en_US";

// hreflang: compute EN and ES versions of the current URL
const pathname = Astro.url.pathname;
const enPath = lang === "es" ? pathname.replace(/^\/es/, "") || "/" : pathname;
const esPath = lang === "es" ? pathname : "/es" + pathname;
const enURL = new URL(enPath, Astro.site);
const esURL = new URL(esPath, Astro.site);

const ogImageURL = new URL("/og-image.png", Astro.site);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Brandon Manzo",
  jobTitle: "Frontend Developer",
  url: "https://boxdev.me",
  sameAs: [
    "https://github.com/brandonmanzo",
    "https://linkedin.com/in/brandonmanzo",
  ],
};

const articleJsonLd =
  type === "article" && date
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description: description,
        url: canonicalURL.href,
        datePublished: date.toISOString(),
        dateModified: (updatedDate ?? date).toISOString(),
        author: {
          "@type": "Person",
          name: "Brandon Manzo",
          url: "https://boxdev.me",
        },
        publisher: {
          "@type": "Person",
          name: "Brandon Manzo",
          url: "https://boxdev.me",
        },
      }
    : null;

const jsonLd = articleJsonLd ?? personJsonLd;
---

<meta name="description" content={description} />
<meta name="author" content="Brandon Manzo" />
<link rel="canonical" href={canonicalURL.href} />

<!-- hreflang -->
<link rel="alternate" hreflang="en" href={enURL.href} />
<link rel="alternate" hreflang="es" href={esURL.href} />
<link rel="alternate" hreflang="x-default" href={enURL.href} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content="BoxDev" />
<meta property="og:image" content={ogImageURL.href} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL.href} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
