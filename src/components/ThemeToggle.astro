---
import { Sun, Moon } from "@lucide/astro";
---

<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
  <span class="icon-wrap">
    <Moon class="icon moon" size={13} />
    <Sun class="icon sun" size={13} />
  </span>
  <span class="theme-toggle__label" id="theme-toggle-label">DARK</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--accent);
  }

  .icon-wrap {
    position: relative;
    width: 13px;
    height: 13px;
  }
  .icon {
    position: absolute;
    inset: 0;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }
  /* default (light) shows sun, hides moon */
  .moon {
    transform: scale(0.5);
    opacity: 0;
  }
  .sun {
    transform: scale(1);
    opacity: 1;
  }
  html[data-theme="dark"] .moon {
    transform: scale(1);
    opacity: 1;
  }
  html[data-theme="dark"] .sun {
    transform: scale(0.5);
    opacity: 0;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    const label = document.getElementById("theme-toggle-label");
    const html = document.documentElement;
    if (!btn) return;

    const sync = () => {
      if (label)
        label.textContent = html.dataset.theme === "dark" ? "DARK" : "LIGHT";
    };
    sync();

    btn.addEventListener("click", () => {
      const next = html.dataset.theme === "dark" ? "light" : "dark";
      html.dataset.theme = next;
      localStorage.setItem("theme", next);
      sync();
    });
  }
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
