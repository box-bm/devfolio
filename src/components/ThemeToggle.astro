---
import { Sun, Moon } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
const lightLabel = t(UiKey["theme.light"]);
const darkLabel = t(UiKey["theme.dark"]);
const switchLabel = t(UiKey["theme.switch"]);
---

<button
  class="theme-toggle"
  id="theme-toggle"
  aria-label={switchLabel.replace("{state}", darkLabel)}
  data-light={lightLabel}
  data-dark={darkLabel}
  data-switch={switchLabel}
>
  <span class="icon-wrap">
    <Moon class="icon moon" size={15} />
    <Sun class="icon sun" size={15} />
  </span>
  <span class="theme-toggle__label" id="theme-toggle-label">{darkLabel}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--accent);
  }

  .icon-wrap {
    position: relative;
    width: 15px;
    height: 15px;
  }
  .icon {
    position: absolute;
    inset: 0;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }
  /* default (light) shows sun, hides moon */
  .moon {
    transform: scale(0.5);
    opacity: 0;
  }
  .sun {
    transform: scale(1);
    opacity: 1;
  }
  html[data-theme="dark"] .moon {
    transform: scale(1);
    opacity: 1;
  }
  html[data-theme="dark"] .sun {
    transform: scale(0.5);
    opacity: 0;
  }
  @media (max-width: 520px) {
    .theme-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .theme-toggle {
      width: 44px;
      justify-content: center;
      padding: 0;
    }
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    const label = document.getElementById("theme-toggle-label");
    const html = document.documentElement;
    if (!btn) return;

    const sync = () => {
      const state =
        html.dataset.theme === "dark" ? btn.dataset.dark : btn.dataset.light;
      if (label) label.textContent = state ?? "";
      btn.setAttribute(
        "aria-label",
        (btn.dataset.switch ?? "").replace("{state}", state ?? ""),
      );
    };
    sync();

    btn.addEventListener("click", () => {
      const next = html.dataset.theme === "dark" ? "light" : "dark";
      html.dataset.theme = next;
      localStorage.setItem("theme", next);
      sync();
    });
  }
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
