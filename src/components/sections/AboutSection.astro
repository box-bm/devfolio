---
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { Image } from "astro:assets";
import MeImage from "@images/me.jpeg";

interface Props {
  years: number;
}
const { years } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { value: `${years}+`, label: t(UiKey["portfolio.about.stats.years.label"]) },
  {
    value: t(UiKey["portfolio.about.stats.projects.value"]),
    label: t(UiKey["portfolio.about.stats.projects.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tech.value"]),
    label: t(UiKey["portfolio.about.stats.tech.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tests.value"]),
    label: t(UiKey["portfolio.about.stats.tests.label"]),
    accent: true,
  },
];
---

<section id="about" class="section">
  <div class="container">
    <SectionHeading index={1} label={t(UiKey["portfolio.about.eyebrow"])} />

    <div class="about__top">
      <div class="about__portrait" data-reveal="left">
        <div class="portrait-frame">
          <Image
            src={MeImage}
            alt="Brandon Manzo"
            class="portrait-img"
            loading="lazy"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) 70vw, 360px"
          />
          <span class="corner-mark corner-mark--tl"></span>
          <span class="corner-mark corner-mark--br"></span>
        </div>
        <div class="portrait-caption">
          <span>{t(UiKey["portfolio.about.location"]).toUpperCase()}</span>
          <span>{t(UiKey["portfolio.about.roleTag"]).toUpperCase()}</span>
        </div>
      </div>

      <div class="about__text">
        <h2 data-reveal>{t(UiKey["portfolio.about.heading"])}</h2>
        <p class="body-large" data-reveal>
          {t(UiKey["portfolio.about.description1"])}
          <span class="accent-text">{years} {t(UiKey["general.years"])}</span>
          {t(UiKey["portfolio.about.description2"])}
        </p>
        <p data-reveal style="--reveal-delay: 80ms">
          {t(UiKey["portfolio.about.description3"])}
        </p>

        <div class="about__stats" data-reveal style="--reveal-delay: 140ms">
          {
            stats.map((stat) => (
              <div class="stat">
                <span
                  class:list={["stat__value", stat.accent && "accent-text"]}
                >
                  {stat.value}
                </span>
                <span class="stat__label">{stat.label}</span>
              </div>
            ))
          }
        </div>

        <div class="fun-fact" data-reveal style="--reveal-delay: 200ms">
          <span class="fun-fact__label"
            >{t(UiKey["portfolio.about.funFact.title"]).toUpperCase()}</span
          >
          <p>{t(UiKey["portfolio.about.funFact.description"])}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about__top {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }

  /* Portrait */
  .portrait-frame {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 12px;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .portrait-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius);
    filter: saturate(0.92);
  }
  .corner-mark {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--accent);
  }
  .corner-mark--tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-mark--br {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  .portrait-caption {
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  /* Text column */
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .about__text h2 {
    margin: 0 0 6px;
  }

  .accent-text {
    color: var(--text-primary);
    font-weight: 500;
  }
  .stat__value.accent-text {
    color: var(--accent);
  }

  /* Stats */
  .about__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .stat {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat:nth-child(2n) {
    border-right: none;
  }
  .stat:nth-last-child(-n + 2) {
    border-bottom: none;
  }
  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat__label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  /* Fun fact */
  .fun-fact {
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .fun-fact__label {
    flex-shrink: 0;
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--corinto-ink, var(--accent));
    white-space: nowrap;
  }
  .fun-fact p {
    margin: 0;
    font-size: 14.5px;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .about__top {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      max-width: 320px;
      margin-inline: auto;
    }
  }
  @media (max-width: 480px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
    .stat {
      border-right: none !important;
    }
    .stat:not(:last-child) {
      border-bottom: 1px solid var(--line) !important;
    }
  }
</style>
