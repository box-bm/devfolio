---
import Card from "@components/Card.astro";
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { Sparkles, MapPin } from "@lucide/astro";
import { Image } from "astro:assets";
import MeImage from "@images/me.jpeg";

interface Props {
  years: number;
}
const { years } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { value: `${years}+`, label: t(UiKey["portfolio.about.stats.years.label"]) },
  {
    value: t(UiKey["portfolio.about.stats.projects.value"]),
    label: t(UiKey["portfolio.about.stats.projects.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tech.value"]),
    label: t(UiKey["portfolio.about.stats.tech.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tests.value"]),
    label: t(UiKey["portfolio.about.stats.tests.label"]),
  },
];
---

<section id="about" class="section">
  <div class="container">
    <SectionHeading
      eyebrow={t(UiKey["portfolio.about.eyebrow"])}
      heading={t(UiKey["portfolio.about.heading"])}
    />

    <div class="about__top">
      <div class="about__portrait" data-reveal="left" data-tilt="6">
        <div class="portrait-frame">
          <Image
            src={MeImage}
            alt="Brandon Manzo"
            class="portrait-img"
            loading="lazy"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) 70vw, 360px"
          />
          <span class="portrait-role"
            >{t(UiKey["portfolio.about.roleTag"])}</span
          >
        </div>
        <div class="portrait-badge">
          <MapPin size={14} />
          {t(UiKey["portfolio.about.location"])}
        </div>
      </div>

      <div class="about__text">
        <p class="body-large" data-reveal>
          {t(UiKey["portfolio.about.description1"])}
          <strong class="accent-text"
            >{years} {t(UiKey["general.years"])}</strong
          >
          {t(UiKey["portfolio.about.description2"])}
        </p>
        <p data-reveal style="--reveal-delay: 80ms">
          {t(UiKey["portfolio.about.description3"])}
        </p>

        <div class="fun-fact" data-reveal style="--reveal-delay: 160ms">
          <span class="fun-fact__icon"><Sparkles size={18} /></span>
          <div>
            <span class="fun-fact__title"
              >{t(UiKey["portfolio.about.funFact.title"])}</span
            >
            <p>{t(UiKey["portfolio.about.funFact.description"])}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="about__stats">
      {
        stats.map((stat, i) => (
          <div data-reveal="scale" style={`--reveal-delay: ${i * 90}ms`}>
            <Card tilt>
              <span class="stat__value gradient-text">{stat.value}</span>
              <span class="stat__label">{stat.label}</span>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about__top {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  /* Portrait */
  .about__portrait {
    position: relative;
    transform-style: preserve-3d;
    transform: perspective(900px) rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
  }
  .portrait-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
    transform: translateZ(30px);
  }
  /* accent glow behind the photo */
  .about__portrait::before {
    content: "";
    position: absolute;
    inset: -14%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow), transparent 65%);
    filter: blur(32px);
    opacity: 0.85;
  }
  .portrait-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .portrait-role {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    padding: 9px 14px;
    border-radius: var(--radius);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--glass-bg-strong);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    border: 1px solid var(--glass-border);
  }
  .portrait-badge {
    position: absolute;
    top: -14px;
    right: -10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-contrast);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: 0 8px 22px var(--accent-glow);
    transform: translateZ(70px);
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .fun-fact {
    display: flex;
    gap: 14px;
    margin-top: 8px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .fun-fact__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: var(--accent-contrast);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  }
  .fun-fact__title {
    font-weight: 600;
    color: var(--text-primary);
  }
  .fun-fact p {
    margin: 4px 0 0;
    font-size: 0.92rem;
  }

  /* Stats */
  .about__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1;
  }
  .stat__label {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .about__top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: left;
    }
    .about__portrait {
      max-width: 320px;
    }
    .about__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 420px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
