---
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

interface Props {
  years: number;
}
const { years } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { value: `${years}+`, label: t(UiKey["portfolio.about.stats.years.label"]) },
  {
    value: t(UiKey["portfolio.about.stats.projects.value"]),
    label: t(UiKey["portfolio.about.stats.projects.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tech.value"]),
    label: t(UiKey["portfolio.about.stats.tech.label"]),
  },
  {
    value: t(UiKey["portfolio.about.stats.tests.value"]),
    label: t(UiKey["portfolio.about.stats.tests.label"]),
    accent: true,
  },
];
---

<section id="about" class="section">
  <div class="container">
    <SectionHeading label={t(UiKey["portfolio.about.eyebrow"])} />

    <div class="about__top">
      <div class="about__text">
        <h2 data-reveal>{t(UiKey["portfolio.about.heading"])}</h2>
        <p class="body-large" data-reveal>
          {t(UiKey["portfolio.about.description1"])}
          <span class="accent-text">{years} {t(UiKey["general.years"])}</span>
          {t(UiKey["portfolio.about.description2"])}
        </p>
        <p data-reveal style="--reveal-delay: 80ms">
          {t(UiKey["portfolio.about.description3"])}
        </p>

        <div class="about__stats" data-reveal style="--reveal-delay: 140ms">
          {
            stats.map((stat) => (
              <div class="stat">
                <span
                  class:list={["stat__value", stat.accent && "accent-text"]}
                >
                  {stat.value}
                </span>
                <span class="stat__label">{stat.label}</span>
              </div>
            ))
          }
        </div>

        <div class="fun-fact" data-reveal style="--reveal-delay: 200ms">
          <span class="fun-fact__label"
            >{t(UiKey["portfolio.about.funFact.title"]).toUpperCase()}</span
          >
          <p>{t(UiKey["portfolio.about.funFact.description"])}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Text column */
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .about__text h2 {
    margin: 0 0 6px;
  }
  .about__text > p {
    max-width: 68ch;
  }

  .accent-text {
    color: var(--text-primary);
    font-weight: 500;
  }
  .stat__value.accent-text {
    color: var(--accent);
  }

  /* Stats — spans the full width of the section */
  .about__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .stat {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
  }
  .stat:last-child {
    border-right: none;
  }
  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat__label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  /* Fun fact — spans the full width, like the stats bar above it */
  .fun-fact {
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .fun-fact__label {
    flex-shrink: 0;
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--corinto-ink, var(--accent));
    white-space: nowrap;
  }
  .fun-fact p {
    margin: 0;
    max-width: 65ch;
    font-size: 14.5px;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .about__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat {
      border-bottom: 1px solid var(--line);
    }
    .stat:nth-child(2n) {
      border-right: none;
    }
    .stat:nth-last-child(-n + 2) {
      border-bottom: none;
    }
  }
  @media (max-width: 480px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
    .stat {
      border-right: none !important;
    }
    .stat:not(:last-child) {
      border-bottom: 1px solid var(--line) !important;
    }
  }
</style>
