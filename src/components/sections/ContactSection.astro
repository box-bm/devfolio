---
import Button from "@components/Button.astro";
import { Mail, Linkedin } from "@lucide/astro";
import { email, linkedIn } from "@constants";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact-panel glass" data-reveal="scale" data-tilt="2">
      <div class="contact-panel__glow" aria-hidden="true"></div>
      <span class="corner-mark corner-mark--tl"></span>
      <span class="corner-mark corner-mark--tr"></span>
      <span class="corner-mark corner-mark--bl"></span>
      <span class="corner-mark corner-mark--br"></span>

      <h2 class="contact-panel__title">
        {t(UiKey["portfolio.contact.title"])}
      </h2>
      <p class="body-large">{t(UiKey["portfolio.contact.description"])}</p>

      <div class="contact-panel__actions">
        <Button href={`mailto:${email}`} magnetic>
          <Mail size={16} />
          {t(UiKey["portfolio.contact.sendEmail"])}
        </Button>
        <Button type="Outlined" href={linkedIn}>
          <Linkedin size={16} />
          {t(UiKey["portfolio.contact.connectOnLinkedin"])}
        </Button>
      </div>

      <p class="caption contact-panel__caption">
        {t(UiKey["portfolio.contact.caption"])}
      </p>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 64px) clamp(24px, 6vw, 56px);
    border-radius: var(--radius-xl);
  }
  .contact-panel__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 50%),
      var(--accent-glow),
      transparent 60%
    );
    pointer-events: none;
  }
  .contact-panel > *:not(.contact-panel__glow):not(.corner-mark) {
    position: relative;
    z-index: 1;
  }

  .corner-mark {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--accent);
  }
  .corner-mark--tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-mark--tr {
    top: -1px;
    right: -1px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .corner-mark--bl {
    bottom: -1px;
    left: -1px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .corner-mark--br {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }

  .contact-panel__title {
    max-width: 24ch;
    font-size: clamp(32px, 4.2vw, 54px);
    line-height: 1.03;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .contact-panel .body-large {
    margin-top: 22px;
    max-width: 52ch;
  }
  .contact-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .contact-panel__caption {
    margin-top: 30px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
</style>
