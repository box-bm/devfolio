---
import { Github, Linkedin } from "@lucide/astro";
import { email, githubProfile, linkedIn } from "@constants";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="section page-break contact">
  <div class="container">
    <h2 class="contact__title">{t(UiKey["portfolio.contact.title"])}</h2>
    <p class="contact__lede">{t(UiKey["portfolio.contact.description"])}</p>

    <a
      class="contact__email"
      href={`mailto:${email}`}
      aria-label={`${t(UiKey["portfolio.contact.sendEmail"])}: ${email}`}
      >{email}</a
    >

    <p class="contact__elsewhere">
      <span>{t(UiKey["portfolio.contact.elsewhere"])}</span>
      <a href={linkedIn} target="_blank" rel="noreferrer"
        ><Linkedin size={18} />LinkedIn</a
      >
      <a href={githubProfile} target="_blank" rel="noreferrer"
        ><Github size={18} />GitHub</a
      >
    </p>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(88px, 12vw, 160px);
  }
  .contact__title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }
  .contact__lede {
    margin-top: 22px;
    max-width: 46ch;
    font-size: 1.2rem;
    color: var(--text-primary);
  }
  .contact__email {
    display: inline-block;
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 100%;
    font-size: clamp(1.5rem, 4.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    color: var(--pencil);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }
  .contact__email:hover {
    text-decoration-thickness: 5px;
  }
  .contact__elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 32px;
    color: var(--text-secondary);
  }
  .contact__elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .contact__elsewhere a:hover {
    color: var(--pencil);
  }
</style>
