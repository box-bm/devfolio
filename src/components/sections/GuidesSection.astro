---
import { ArrowRight } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { getGuides, guideDateFormat, guideHref } from "@utils/guides";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const guides = await getGuides(lang);
const fmt = guideDateFormat(lang);
---

{
  guides.length > 0 && (
    <section id="notes" class="section page-break">
      <div class="container notes">
        <header class="notes__head">
          <h2>{t(UiKey["portfolio.guides.title"])}</h2>
          <p>{t(UiKey["portfolio.guides.description"])}</p>
          <a class="notes__all" href={`/${lang}/guides`}>
            {t(UiKey["portfolio.guides.viewAll"])}
            <ArrowRight size={18} />
          </a>
        </header>

        <ol class="ruled">
          {guides.map((guide) => (
            <li data-reveal>
              <a class="ruled-link" href={guideHref(guide, lang)}>
                <time
                  class="ruled-link__meta"
                  datetime={guide.data.date.toISOString()}
                >
                  {fmt.format(guide.data.date)}
                </time>
                <span class="ruled-link__title">{guide.data.title}</span>
                {guide.data.description && (
                  <span class="ruled-link__desc">{guide.data.description}</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .notes__head {
    position: sticky;
    top: 112px;
  }
  .notes__head p {
    margin-top: 16px;
    font-size: 1.1rem;
    max-width: 36ch;
  }
  .notes__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    min-height: 32px;
    font-weight: 600;
    color: var(--pencil);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .notes__all:hover {
    text-decoration-thickness: 3px;
  }

  @media (max-width: 860px) {
    .notes {
      grid-template-columns: 1fr;
    }
    .notes__head {
      position: static;
    }
  }
</style>
