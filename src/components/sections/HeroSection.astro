---
import Button from "@components/Button.astro";
import PencilNote from "@components/visuals/PencilNote.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { ArrowDown } from "@lucide/astro";
import { Image } from "astro:assets";
import MeImage from "@images/me.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="top" class="hero">
  <div class="container hero__grid">
    <figure class="study">
      <div class="study__sheet">
        <Image
          src={MeImage}
          alt={t(UiKey["portfolio.hero.photoAlt"])}
          class="study__img"
          loading="eager"
          widths={[400, 560, 800]}
          sizes="(max-width: 860px) 80vw, 460px"
        />
        <span class="study__hatch" aria-hidden="true"></span>
      </div>
      <span class="tape tape--top" aria-hidden="true"></span>
      <span class="tape tape--bottom" aria-hidden="true"></span>
      <figcaption class="study__note">
        <PencilNote arrow="down-left"
          >{t(UiKey["portfolio.hero.note"])}</PencilNote
        >
      </figcaption>
    </figure>

    <div class="hero__text">
      <h1 class="hero__name">Brandon<br />Manzo</h1>
      <p class="hero__lede">{t(UiKey["portfolio.hero.lede"])}</p>

      <div class="hero__actions">
        <Button href="#work" target="_self">
          {t(UiKey["portfolio.hero.viewWork"])}
          <ArrowDown size={18} />
        </Button>
        <Button type="Outlined" href="#contact" target="_self">
          {t(UiKey["portfolio.hero.getInTouch"])}
        </Button>
      </div>

      <p class="hero__clock">
        {t(UiKey["portfolio.localTime"])}
        <time data-gt-clock>--:--</time>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(112px, 13vw, 156px);
    padding-bottom: clamp(64px, 9vw, 112px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 104px);
    align-items: center;
  }

  /* ---- The taped-in portrait study ------------------------------- */
  .study {
    position: relative;
    margin: 0;
    max-width: 460px;
    justify-self: end;
    width: 100%;
    transform: rotate(-1.6deg);
  }
  .study__sheet {
    position: relative;
    padding: clamp(14px, 2vw, 22px);
    background: var(--sheet);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .study__sheet :global(.study__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    filter: grayscale(1) contrast(1.18) brightness(1.06);
    mix-blend-mode: multiply;
  }
  /* graphite hatching, heavier toward the edges like a shaded study */
  .study__hatch {
    position: absolute;
    inset: clamp(14px, 2vw, 22px);
    background: repeating-linear-gradient(
      -45deg,
      rgba(34, 35, 38, 0.22) 0 1px,
      transparent 1px 6px
    );
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(
      ellipse 62% 58% at 50% 40%,
      transparent 55%,
      #000 100%
    );
    mask-image: radial-gradient(
      ellipse 62% 58% at 50% 40%,
      transparent 55%,
      #000 100%
    );
    pointer-events: none;
  }

  .tape {
    position: absolute;
    width: 116px;
    height: 30px;
    background: var(--tape);
    border-left: 1px dashed var(--tape-edge);
    border-right: 1px dashed var(--tape-edge);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  .tape--top {
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(3deg);
  }
  .tape--bottom {
    bottom: -12px;
    right: -26px;
    transform: rotate(-38deg);
  }

  .study__note {
    position: absolute;
    top: -66px;
    right: -84px;
  }

  /* ---- Words ----------------------------------------------------- */
  .hero__name {
    font-size: clamp(3.5rem, 9.4vw, 8.25rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: var(--text-primary);
  }
  .hero__lede {
    margin-top: clamp(22px, 3vw, 34px);
    max-width: 34ch;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.5;
    color: var(--text-primary);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 3.6vw, 40px);
  }
  .hero__clock {
    margin-top: 28px;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  .hero__clock time {
    margin-left: 6px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .study {
      justify-self: start;
      max-width: min(200px, 52vw);
      margin-top: 24px;
      margin-bottom: 8px;
    }
    .study__note {
      top: 30%;
      right: auto;
      left: calc(100% + 8px);
    }
  }
</style>

<script>
  // Guatemala City has no daylight saving time, so this is always UTC-6.
  function startClock() {
    const el = document.querySelector<HTMLTimeElement>("[data-gt-clock]");
    if (!el) return;
    const fmt = new Intl.DateTimeFormat(document.documentElement.lang || "en", {
      timeZone: "America/Guatemala",
      hour: "2-digit",
      minute: "2-digit",
    });
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
    };
    tick();
    const id = window.setInterval(tick, 30_000);
    document.addEventListener("astro:before-swap", () => clearInterval(id), {
      once: true,
    });
  }
  document.addEventListener("astro:page-load", startClock);
</script>
