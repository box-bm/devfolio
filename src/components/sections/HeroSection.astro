---
import Button from "@components/Button.astro";
import ContactLinks from "@components/ContactLinks.astro";
import HeroVisual from "@components/visuals/HeroVisual.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { Layers, Smartphone, ShieldCheck, ChevronDown } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="status" data-reveal>
        <span class="status__dot"></span>
        {t(UiKey["portfolio.hero.available"])}
      </span>

      <span class="eyebrow" data-reveal style="--reveal-delay: 60ms">
        {t(UiKey["portfolio.hero.eyebrow"])}
      </span>

      <h1 class="hero__title" data-reveal style="--reveal-delay: 120ms">
        {t(UiKey["portfolio.hero.title"])}
        <span class="gradient-text">{t(UiKey["portfolio.hero.highlight"])}</span
        >
      </h1>

      <p
        class="body-large hero__caption"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        {t(UiKey["portfolio.hero.caption"])}
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 280ms">
        <Button href="#projects" target="_parent" magnetic>
          {t(UiKey["portfolio.hero.viewWork"])}
        </Button>
        <Button type="Outlined" href="#contact" target="_parent">
          {t(UiKey["portfolio.hero.getInTouch"])}
        </Button>
      </div>

      <div class="hero__roles" data-reveal style="--reveal-delay: 360ms">
        <span class="role"
          ><Layers size={16} />{t(UiKey["portfolio.hero.role.frontend"])}</span
        >
        <span class="role"
          ><Smartphone size={16} />{
            t(UiKey["portfolio.hero.role.mobile"])
          }</span
        >
        <span class="role"
          ><ShieldCheck size={16} />{
            t(UiKey["portfolio.hero.role.testing"])
          }</span
        >
      </div>

      <div class="hero__social" data-reveal style="--reveal-delay: 440ms">
        <ContactLinks />
      </div>
    </div>

    <div
      class="hero__visual"
      data-reveal="scale"
      style="--reveal-delay: 200ms"
      data-parallax="0.05"
    >
      <HeroVisual />
    </div>
  </div>

  <a
    href="#about"
    class="scroll-cue"
    aria-label={t(UiKey["portfolio.hero.scroll"])}
  >
    <span>{t(UiKey["portfolio.hero.scroll"])}</span>
    <ChevronDown size={18} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 80px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(22, 163, 74, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
    }
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
  }
  .hero__title .gradient-text {
    display: block;
  }

  .hero__caption {
    max-width: 540px;
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .hero__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 8px;
  }
  .role {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .role :global(svg) {
    color: var(--accent);
  }

  .hero__social {
    margin-top: 6px;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .scroll-cue :global(svg) {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero__visual {
      order: -1;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
