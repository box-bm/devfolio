---
import Button from "@components/Button.astro";
import ContactLinks from "@components/ContactLinks.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { ArrowRight, Mail } from "@lucide/astro";
import { Image } from "astro:assets";
import MeImage from "@images/me.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow" data-reveal style="--reveal-delay: 60ms">
        {t(UiKey["portfolio.hero.eyebrow"])}
      </p>

      <h1 class="hero__title" data-reveal style="--reveal-delay: 120ms">
        {t(UiKey["portfolio.hero.title"])}
        <span class="gradient-text">{t(UiKey["portfolio.hero.highlight"])}</span
        >
      </h1>

      <p
        class="body-large hero__caption"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        {t(UiKey["portfolio.hero.caption"])}
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 280ms">
        <Button href="#projects" target="_parent" magnetic>
          {t(UiKey["portfolio.hero.viewWork"])}
          <ArrowRight size={16} />
        </Button>
        <Button type="Outlined" href="#contact" target="_parent">
          <Mail size={16} />
          {t(UiKey["portfolio.hero.getInTouch"])}
        </Button>
      </div>

      <div class="hero__social" data-reveal style="--reveal-delay: 320ms">
        <ContactLinks />
      </div>

      <div class="hero__roles" data-reveal style="--reveal-delay: 360ms">
        <span class="role">{t(UiKey["portfolio.hero.role.frontend"])}</span>
        <span class="role">{t(UiKey["portfolio.hero.role.mobile"])}</span>
        <span class="role">{t(UiKey["portfolio.hero.role.testing"])}</span>
      </div>
    </div>

    <div class="hero__visual" data-reveal="scale" style="--reveal-delay: 200ms">
      <div class="hero__portrait">
        <Image
          src={MeImage}
          alt="Brandon Manzo"
          class="hero__portrait-img"
          loading="eager"
          widths={[360, 480, 640]}
          sizes="(max-width: 900px) 70vw, 420px"
        />
        <span class="corner-marks corner-marks--two" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </span>
      </div>
    </div>

    <div class="scroll-cue">
      <span class="scroll-cue__line"></span>
      <span>{t(UiKey["portfolio.hero.scroll"])}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(140px, 16vw, 176px);
    padding-bottom: 118px;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: start;
    gap: clamp(32px, 6vw, 64px);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .eyebrow {
    margin: 0 0 14px;
  }

  .hero__title {
    font-size: clamp(42px, 6.4vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero__title .gradient-text {
    display: block;
  }

  .hero__caption {
    margin-top: 28px;
    max-width: 52ch;
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero__social {
    margin-top: 22px;
  }

  .hero__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 44px;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-secondary);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 5px 10px;
  }

  .hero__visual {
    margin-top: 62px;
  }
  .hero__portrait {
    position: relative;
    max-width: 420px;
    margin-inline: auto;
  }
  .hero__portrait :global(.hero__portrait-img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    filter: saturate(0.92);
  }

  .scroll-cue {
    position: absolute;
    left: -4px;
    bottom: -80px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .scroll-cue__line {
    width: 26px;
    height: 1px;
    background: var(--line);
  }
  .scroll-cue span:last-child {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero__visual {
      order: -1;
      margin-top: 0;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
