---
import Card from "@components/Card.astro";
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { Palette, Users, Gauge, ShieldCheck } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const points = [
  {
    icon: Palette,
    title: t(UiKey["portfolio.about.whyWorkWithMe.designAndDevelopment.title"]),
    desc: t(
      UiKey["portfolio.about.whyWorkWithMe.designAndDevelopment.description"],
    ),
  },
  {
    icon: Users,
    title: t(UiKey["portfolio.about.whyWorkWithMe.userApproach.title"]),
    desc: t(UiKey["portfolio.about.whyWorkWithMe.userApproach.description"]),
  },
  {
    icon: Gauge,
    title: t(UiKey["portfolio.about.whyWorkWithMe.performance.title"]),
    desc: t(UiKey["portfolio.about.whyWorkWithMe.performance.description"]),
  },
  {
    icon: ShieldCheck,
    title: t(UiKey["portfolio.about.whyWorkWithMe.testing.title"]),
    desc: t(UiKey["portfolio.about.whyWorkWithMe.testing.description"]),
  },
];
---

<section id="approach" class="section">
  <div class="container">
    <SectionHeading
      eyebrow={t(UiKey["portfolio.about.whyWorkWithMe.eyebrow"])}
      heading={t(UiKey["portfolio.about.whyWorkWithMe.title"])}
    />

    <div class="approach__grid">
      {
        points.map((p, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <Card glow={false}>
              <span class="approach__num">0{i + 1}</span>
              <span class="approach__icon">
                <p.icon size={20} />
              </span>
              <h3 class="h4">{p.title}</h3>
              <p>{p.desc}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .approach__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 18px;
  }
  .approach__grid :global(.card) {
    gap: 12px;
  }
  .approach__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }
  .approach__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--accent);
    background: var(--accent-soft);
  }
  .approach p {
    font-size: 0.92rem;
  }
</style>
