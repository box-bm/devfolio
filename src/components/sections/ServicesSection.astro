---
import Card from "@components/Card.astro";
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import {
  Monitor,
  Smartphone,
  Server,
  ShieldCheck,
  FlaskConical,
} from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    icon: Monitor,
    title: t(UiKey["portfolio.services.frontend.title"]),
    desc: t(UiKey["portfolio.services.frontend.description"]),
  },
  {
    icon: Smartphone,
    title: t(UiKey["portfolio.services.mobile.title"]),
    desc: t(UiKey["portfolio.services.mobile.description"]),
  },
  {
    icon: Server,
    title: t(UiKey["portfolio.services.backend.title"]),
    desc: t(UiKey["portfolio.services.backend.description"]),
  },
  {
    icon: ShieldCheck,
    title: t(UiKey["portfolio.services.qa.title"]),
    desc: t(UiKey["portfolio.services.qa.description"]),
  },
  {
    icon: FlaskConical,
    title: t(UiKey["portfolio.services.testing.title"]),
    desc: t(UiKey["portfolio.services.testing.description"]),
    featured: true,
  },
];
---

<section id="services" class="section">
  <div class="container">
    <SectionHeading
      index={2}
      label={t(UiKey["portfolio.services.eyebrow"])}
      heading={t(UiKey["portfolio.services.heading"])}
      description={t(UiKey["portfolio.services.description"])}
      split
    />

    <div class="services__grid">
      {
        services.map((s, i) => (
          <div
            class:list={["service", s.featured && "service--featured"]}
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <Card>
              <div class="service__top">
                <span class="service__icon-group">
                  <s.icon size={17} class="service__icon" />
                  <span class="service__num">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </span>
                {s.featured && (
                  <span class="service__badge">
                    {t(UiKey["portfolio.services.favorite"])}
                  </span>
                )}
              </div>
              <h3 class="h4">{s.title}</h3>
              <p>{s.desc}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .service {
    position: relative;
  }
  .service :global(.card) {
    gap: 0;
  }

  .service__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .service__icon-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .service__icon {
    color: var(--accent);
  }
  .service__num {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
  }

  .service h3 {
    margin: 14px 0 10px;
  }
  .service p {
    margin: 0;
    font-size: 14px;
  }

  /* Featured testing card */
  .service--featured {
    grid-column: span 2;
  }
  .service--featured :global(.card) {
    border-color: var(--corinto-ink, var(--accent));
    --accent-glow: rgba(201, 138, 147, 0.12);
  }
  .service__badge {
    padding: 4px 8px;
    border: 1px solid var(--corinto-ink, var(--accent));
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--corinto-ink, var(--accent));
  }
  .service--featured p {
    max-width: 64ch;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .service--featured {
      grid-column: span 2;
    }
  }
  @media (max-width: 620px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
    .service--featured {
      grid-column: span 1;
    }
  }
</style>
