---
import TechChip from "@components/TechChip.astro";
import SectionHeading from "@components/visuals/SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  {
    label: t(UiKey["portfolio.about.skillsAndTech.frameworksAndLibraries"]),
    desc: t(UiKey["portfolio.skills.frameworksDescription"]),
    techs: ["React", "React Native", "Flutter", "Astro", "Next.JS", "Nestjs"],
  },
  {
    label: t(UiKey["portfolio.about.skillsAndTech.languages"]),
    desc: t(UiKey["portfolio.skills.languagesDescription"]),
    techs: [
      "Typescript",
      "Javascript",
      "Dart",
      "Kotlin",
      "Swift",
      "Rust",
      "CPlusplus",
    ],
  },
  {
    label: t(UiKey["portfolio.about.skillsAndTech.testingAndQa"]),
    desc: t(UiKey["portfolio.skills.testingDescription"]),
    techs: ["Jest", "Vitest", "Testing Library", "Postman"],
  },
  {
    label: t(UiKey["portfolio.about.skillsAndTech.tools"]),
    desc: t(UiKey["portfolio.skills.toolsDescription"]),
    techs: [
      "Git",
      "Github",
      "NeoVim",
      "Xcode",
      "Androidstudio",
      "Node",
      "Figma",
      "Storybook",
      "Prettier",
      "Eslint",
    ],
  },
] as const;
---

<section id="skills" class="section">
  <div class="container">
    <SectionHeading
      label={t(UiKey["portfolio.skills.eyebrow"])}
      heading={t(UiKey["portfolio.skills.heading"])}
      description={t(UiKey["portfolio.skills.description"])}
      split
    />

    <div class="skills__list">
      {
        categories.map((cat, i) => (
          <div
            class="skill-row"
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <div class="skill-row__label">
              <h3>{cat.label}</h3>
              <p>{cat.desc}</p>
            </div>
            <div class="skill-row__chips">
              {cat.techs.map((tech) => (
                <TechChip tech={tech} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__list {
    display: flex;
    flex-direction: column;
  }

  .skill-row {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: 48px;
    padding: 44px 0;
    border-bottom: 1px solid var(--line-soft);
    align-items: start;
  }
  .skill-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .skill-row__label h3 {
    margin: 0 0 8px;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .skill-row__label p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    max-width: 30ch;
  }

  .skill-row__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  @media (max-width: 700px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
