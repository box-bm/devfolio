---
import Card from "@components/Card.astro";
import {
  Activity,
  MapPin,
  CodeXml,
  FlaskConical,
  Package,
  ArrowUpRight,
} from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import { githubRepos } from "@constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="currently" data-tilt="4">
  <Card>
    <div class="currently__header">
      <Activity size={14} />
      <span>{t(UiKey["portfolio.hero.currently.label"])}</span>
    </div>

    <div class="currently__row">
      <MapPin size={16} class="currently__icon" />
      <div>
        <div class="currently__value">
          {t(UiKey["portfolio.hero.currently.location"])}
        </div>
        <div class="currently__caption">
          {t(UiKey["portfolio.hero.currently.locationCaption"])}
        </div>
      </div>
    </div>

    <div class="currently__row">
      <CodeXml size={16} class="currently__icon" />
      <div>
        <div class="currently__value">
          {t(UiKey["portfolio.hero.currently.stack"])}
        </div>
        <div class="currently__caption">
          {t(UiKey["portfolio.hero.currently.stackCaption"])}
        </div>
      </div>
    </div>

    <div class="currently__row">
      <FlaskConical size={16} class="currently__icon" />
      <div>
        <div class="currently__value">
          {t(UiKey["portfolio.hero.currently.testing"])}
        </div>
        <div class="currently__caption">
          {t(UiKey["portfolio.hero.currently.testingCaption"])}
        </div>
      </div>
    </div>

    <a
      class="currently__link"
      href={githubRepos}
      target="_blank"
      rel="noreferrer"
    >
      <span class="currently__link-label">
        <Package size={16} />
        {t(UiKey["portfolio.hero.currently.latest"])}
      </span>
      <ArrowUpRight size={16} />
    </a>
  </Card>
</div>

<style>
  .currently :global(.card) {
    padding: 0;
    gap: 0;
    overflow: hidden;
  }
  .currently :global(.card__inner) {
    gap: 0;
  }

  .currently__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .currently__header span {
    color: var(--text-secondary);
  }

  .currently__row {
    display: flex;
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line-soft);
    align-items: flex-start;
  }
  .currently__icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--text-secondary);
  }
  .currently__value {
    font-size: 14.5px;
    color: var(--text-primary);
  }
  .currently__caption {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
  }

  .currently__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 22px;
    color: var(--text-primary) !important;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .currently__link:hover {
    background: var(--surface-2);
    color: var(--accent) !important;
  }
  .currently__link-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14.5px;
  }
  .currently__link-label :global(svg) {
    color: var(--accent);
  }
</style>
