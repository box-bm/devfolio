---
import { Check, Smartphone, Zap } from "@lucide/astro";
---

<div class="hero-visual" data-tilt="9" aria-hidden="true">
  <div class="scene">
    <!-- main glass app window -->
    <div class="pane pane--main glass" style="--z: 40px">
      <div class="pane__bar">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="pane__title">interface.tsx</span>
      </div>
      <div class="pane__body">
        <span class="ln" style="width: 70%"></span>
        <span class="ln ln--accent" style="width: 45%"></span>
        <span class="ln" style="width: 85%"></span>
        <span class="ln" style="width: 55%"></span>
        <div class="pane__cta">Ship it</div>
      </div>
    </div>

    <!-- floating mobile chip -->
    <div class="pane pane--phone glass" style="--z: 90px">
      <div class="phone__notch"></div>
      <Smartphone size={26} />
      <span class="phone__label">Mobile</span>
    </div>

    <!-- tests passing badge -->
    <div class="pane pane--badge glass" style="--z: 120px">
      <span class="badge__icon"><Check size={16} /></span>
      <span>tests passing</span>
    </div>

    <!-- perf chip -->
    <div class="pane pane--perf glass" style="--z: 70px">
      <Zap size={16} />
      <span>100 perf</span>
    </div>

    <div class="orb"></div>
  </div>
</div>

<style>
  .hero-visual {
    perspective: 1200px;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    transform-style: preserve-3d;
  }

  .scene {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 220ms var(--ease-out);
    animation: float-scene 9s ease-in-out infinite;
  }

  .pane {
    position: absolute;
    border-radius: var(--radius);
    transform: translateZ(var(--z, 0));
    transform-style: preserve-3d;
  }

  /* main window */
  .pane--main {
    inset: 14% 8% 14% 8%;
    padding: 0;
    overflow: hidden;
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--glass-highlight);
  }
  .pane__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--glass-border);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot:first-child {
    background: var(--accent);
  }
  .pane__title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }
  .pane__body {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ln {
    height: 11px;
    border-radius: 999px;
    background: var(--line-strong);
    display: block;
  }
  .ln--accent {
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
  }
  .pane__cta {
    margin-top: 8px;
    align-self: flex-start;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-contrast);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: var(--shadow-glow);
  }

  /* floating chips */
  .pane--phone {
    width: 96px;
    height: 116px;
    left: -6%;
    bottom: 6%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--accent);
    animation: float-a 6s ease-in-out infinite;
  }
  .phone__notch {
    position: absolute;
    top: 8px;
    width: 34px;
    height: 5px;
    border-radius: 999px;
    background: var(--line-strong);
  }
  .phone__label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .pane--badge {
    right: -4%;
    top: 8%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    animation: float-b 7s ease-in-out infinite;
  }
  .badge__icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #fff;
    background: #16a34a;
  }

  .pane--perf {
    right: 2%;
    bottom: 12%;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--accent);
    animation: float-a 8s ease-in-out infinite reverse;
  }

  .orb {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      var(--accent-glow),
      transparent 65%
    );
    filter: blur(36px);
    transform: translateZ(-60px);
    opacity: 0.8;
  }

  @keyframes float-scene {
    0%,
    100% {
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(0);
    }
    50% {
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
        translateY(-12px);
    }
  }
  @keyframes float-a {
    0%,
    100% {
      transform: translateZ(var(--z)) translateY(0);
    }
    50% {
      transform: translateZ(var(--z)) translateY(-14px);
    }
  }
  @keyframes float-b {
    0%,
    100% {
      transform: translateZ(var(--z)) translateY(0);
    }
    50% {
      transform: translateZ(var(--z)) translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene,
    .pane--phone,
    .pane--badge,
    .pane--perf {
      animation: none !important;
    }
  }

  @media (max-width: 560px) {
    .hero-visual {
      max-width: 320px;
    }
  }
</style>
