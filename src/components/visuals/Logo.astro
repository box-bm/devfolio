---
interface Props {
  variant?: "nav" | "footer";
  href?: string;
}

const { variant = "nav", href = "/" } = Astro.props;
---

<a class:list={["logo", `logo--${variant}`]} href={href}>
  <span class="logo__mark">
    <span class="logo__bracket logo__bracket--tl"></span>
    <span class="logo__bracket logo__bracket--br"></span>
    <span class="logo__letter">B</span>
  </span>
  <span class="logo__text">boxdev</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text-primary);
  }

  .logo__mark {
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .logo--nav .logo__mark {
    width: 30px;
    height: 30px;
  }
  .logo--footer .logo__mark {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
  }

  .logo__bracket {
    position: absolute;
    width: 7px;
    height: 7px;
    border-color: var(--accent);
  }
  .logo--footer .logo__bracket {
    width: 6px;
    height: 6px;
  }
  .logo__bracket--tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .logo__bracket--br {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  .logo--footer .logo__bracket--br {
    display: none;
  }

  .logo__letter {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .logo--footer .logo__letter {
    font-size: 12px;
  }

  .logo__text {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .logo--footer .logo__text {
    font-size: 12px;
    color: var(--text-secondary);
  }
</style>
