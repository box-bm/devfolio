---
/** Fixed backdrop: a soft warm glow over the near-dark/near-light base.
 *  Purely decorative — mounted once in Base.astro. */
---

<div class="mesh" aria-hidden="true"></div>

<style>
  .mesh {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(
        1100px 640px at 78% -10%,
        var(--accent-glow),
        transparent 64%
      ),
      radial-gradient(760px 460px at 2% 28%, var(--glow-2), transparent 62%),
      var(--bg);
  }
</style>
