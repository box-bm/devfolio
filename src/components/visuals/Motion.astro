---
/**
 * Motion.astro
 * Global, dependency-free motion engine. Mounted once in Base.astro.
 *  - [data-reveal]            settle-in on first view (content is visible without JS)
 *  - [data-draw]              blue-pencil SVG strokes draw themselves when the note enters view
 *  - [data-site-header]       gets .scrolled past a threshold
 *  - [data-nav-link]          gets .active when its target section is in view
 * Re-runs on every astro:page-load (View Transitions) and honours prefers-reduced-motion.
 */
---

<script>
  const PREFERS_REDUCED = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- elements refreshed on every page load -----------------------------
  let header: HTMLElement | null = null;
  let navLinks: HTMLAnchorElement[] = [];

  function setupReveal() {
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (PREFERS_REDUCED()) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );
    els.forEach((el) => io.observe(el));
  }

  function setupDraw() {
    const notes = document.querySelectorAll<SVGSVGElement>("[data-draw]");
    if (PREFERS_REDUCED() || !("IntersectionObserver" in window)) return;
    notes.forEach((svg) => {
      svg.querySelectorAll<SVGGeometryElement>("path").forEach((p, i) => {
        const len = Math.ceil(p.getTotalLength());
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
        p.style.transition = `stroke-dashoffset 900ms cubic-bezier(0.16, 1, 0.3, 1) ${250 + i * 220}ms`;
      });
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target
            .querySelectorAll<SVGGeometryElement>("path")
            .forEach((p) => (p.style.strokeDashoffset = "0"));
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    notes.forEach((n) => io.observe(n));
  }

  function setupActiveNav() {
    navLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    ];
    const ids = navLinks
      .map((l) => l.getAttribute("href")?.split("#")[1])
      .filter(Boolean) as string[];
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];
    if (!sections.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          navLinks.forEach((l) =>
            l.classList.toggle(
              "active",
              l.getAttribute("href")?.endsWith("#" + id) ?? false,
            ),
          );
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
    );
    sections.forEach((s) => io.observe(s));
  }

  function onScroll() {
    header?.classList.toggle("scrolled", window.scrollY > 8);
  }

  let ticking = false;
  function scrollHandler() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      onScroll();
      ticking = false;
    });
  }

  function refreshGlobals() {
    header = document.querySelector("[data-site-header]");
    onScroll();
  }

  function init() {
    setupReveal();
    setupDraw();
    setupActiveNav();
    refreshGlobals();
  }

  // attach the single global scroll listener once
  if (!(window as any).__motionGlobal) {
    (window as any).__motionGlobal = true;
    window.addEventListener("scroll", scrollHandler, { passive: true });
  }

  document.addEventListener("astro:page-load", init);
</script>
