---
import "@styles/GlobalStyles.astro";
import "normalize.css";
import SEO from "@components/SEO.astro";
import MeshBackground from "@components/visuals/MeshBackground.astro";
import Motion from "@components/visuals/Motion.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  type?: "website" | "article";
  date?: Date;
  updatedDate?: Date;
}

const { title, description, lang, type, date, updatedDate } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="meta" />
    {
      description && (
        <SEO
          title={title ?? ""}
          description={description}
          lang={lang}
          type={type}
          date={date}
          updatedDate={updatedDate}
        />
      )
    }
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta
      name="theme-color"
      content="#06070b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#eef0f4"
      media="(prefers-color-scheme: light)"
    />
    <ClientRouter />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Work+Sans:ital,wght@0,300..700;1,300..600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme = stored ?? (prefersDark ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <MeshBackground />
    <slot />
    <Motion />
  </body>
</html>
