---
import "@styles/GlobalStyles.astro";
import "normalize.css";
import SEO from "@components/SEO.astro";
import MeshBackground from "@components/visuals/MeshBackground.astro";
import Motion from "@components/visuals/Motion.astro";
import NavProgress from "@components/visuals/NavProgress.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  type?: "website" | "article";
  date?: Date;
  updatedDate?: Date;
}

const { title, description, lang, type, date, updatedDate } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="meta" />
    {
      description && (
        <SEO
          title={title ?? ""}
          description={description}
          lang={lang}
          type={type}
          date={date}
          updatedDate={updatedDate}
        />
      )
    }
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta
      name="theme-color"
      content="#15171a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f5f4f2"
      media="(prefers-color-scheme: light)"
    />
    <ClientRouter />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      function applyStoredTheme(doc) {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        doc.documentElement.dataset.theme =
          stored ?? (prefersDark ? "dark" : "light");
      }
      applyStoredTheme(document);
      // View transitions swap in a freshly server-rendered <html> that has no
      // data-theme yet — reapply the stored theme before it's painted so
      // navigating to another page doesn't flash back to the default theme.
      document.addEventListener("astro:before-swap", (event) => {
        applyStoredTheme(event.newDocument);
      });
    </script>
  </head>
  <body>
    <MeshBackground transition:persist />
    <NavProgress />
    <slot />
    <Motion />
  </body>
</html>
