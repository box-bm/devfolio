---
import Document from "@layouts/Document.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  guide?: string;
  date?: Date;
  updatedDate?: Date;
}
const {
  title = t(UiKey["title.guides"]),
  description,
  type,
  guide,
  date,
  updatedDate,
} = Astro.props;

const crumbs: { label: string; href?: string }[] = guide
  ? [
      { label: t(UiKey["nav.guides"]), href: `/${lang}/guides` },
      { label: guide },
    ]
  : [{ label: t(UiKey["nav.guides"]) }];
---

<Document
  title={title}
  description={description}
  lang={lang}
  type={type}
  date={date}
  updatedDate={updatedDate}
  crumbs={crumbs}
>
  <slot />
</Document>
