---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Base from "@layouts/Base.astro";
import Footer from "@components/Footer.astro";
import Bradcrumb from "@components/BreadCrumb.astro";
import Header from "@components/Header.astro";
import { UiKey } from "@i18n/ui";
import LegalStyles from "@styles/LegalStyles.astro";
import MarkdownStyles from "@styles/MarkdownStyles.astro";
import BuyMeACoffee from "@components/BuyMeACoffee.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  document?: string;
}
const { title = t(UiKey["title.legal"]), document } = Astro.props;
const breadcrumbItems = [
  { label: t(UiKey["legal.title"]), href: `/${lang}/legal` },
];
if (document) {
  breadcrumbItems.push({ label: document, href: "" });
}
---

<Base title={title} lang={lang}>
  <LegalStyles />
  <MarkdownStyles />
  <Header hideMenu />
  <main class="doc-main">
    <div class="doc-breadcrumb">
      <Bradcrumb items={breadcrumbItems} />
    </div>
    <div class="markdown-body">
      <slot />
    </div>
  </main>
  <Footer />
  <BuyMeACoffee />
  <style>
    .doc-breadcrumb {
      max-width: 72ch;
      margin: 0 auto;
      padding: 20px 16px 0;
    }
  </style>
</Base>
