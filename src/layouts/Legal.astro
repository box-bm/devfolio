---
import Document from "@layouts/Document.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import type { Lang } from "@i18n/langs";

interface Props {
  title?: string;
  document?: string;
  /** The old store-linked routes put the language last in the URL. */
  lang?: Lang;
}

const {
  title: pageTitle,
  document,
  lang = getLangFromUrl(Astro.url),
} = Astro.props;
const t = useTranslations(lang);
const title = pageTitle ?? t(UiKey["title.legal"]);
const standalone = Astro.props.lang !== undefined;

const crumbs: { label: string; href?: string }[] = document
  ? [
      { label: t(UiKey["legal.title"]), href: `/${lang}/legal` },
      { label: document },
    ]
  : [{ label: t(UiKey["legal.title"]) }];
---

<Document title={title} lang={lang} crumbs={crumbs} hideLanguage={standalone}>
  <slot />
</Document>
