---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { UiKey } from "@i18n/ui";
import Base from "@layouts/Base.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BoxDev — Frontend & Mobile Developer",
  description = "Brandon Manzo — frontend & mobile developer obsessed with motion, detail and tested, reliable code.",
} = Astro.props;
---

<Base title={title} description={description} lang={lang} type="website">
  <Header>
    <a slot="link" class="header-link" data-nav-link href="#about">
      {t(UiKey["nav.about"])}
    </a>
    <a slot="link" class="header-link" data-nav-link href="#services">
      {t(UiKey["nav.services"])}
    </a>
    <a slot="link" class="header-link" data-nav-link href="#skills">
      {t(UiKey["nav.skills"])}
    </a>
    <a slot="link" class="header-link" data-nav-link href="#projects">
      {t(UiKey["nav.projects"])}
    </a>
    <a slot="link" class="header-link" href={`/${lang}/guides`}>
      {t(UiKey["nav.guides"])}
    </a>
    <a slot="link" class="header-link" data-nav-link href="#contact">
      {t(UiKey["nav.contact"])}
    </a>
  </Header>
  <main>
    <slot />
  </main>
  <Footer />
</Base>
