---
import GuidesLayout from "@layouts/Guides.astro";
import Contents from "@components/docs/Contents.astro";
import Button from "@components/Button.astro";
import MeImage from "@images/me.jpeg";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getCollection } from "astro:content";
import { UiKey } from "@i18n/ui";
import { Image } from "astro:assets";
import { ArrowRight, Coffee, Mail } from "@lucide/astro";
import { buyMeACoffee, email } from "@constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
  const guides = await getCollection("guides", (guide) => !guide.data.draft);

  return guides.flatMap((guide) => ({
    props: {
      guide,
    },
    params: {
      lang: guide.id.split(".")[1],
      slug: guide.id.split(".")[0],
    },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await guide.render();

const fmt = new Intl.DateTimeFormat(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Guatemala",
});
const minutes = Math.max(
  1,
  Math.ceil((guide.body ?? "").split(/\s+/).filter(Boolean).length / 220),
);

// The next older guide in this language, wrapping to the newest.
const siblings = (
  await getCollection(
    "guides",
    (g) => !g.data.draft && g.id.endsWith(`${lang}.md`),
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const at = siblings.findIndex((g) => g.id === guide.id);
const next =
  siblings.length > 1 ? siblings[(at + 1) % siblings.length] : undefined;
const sameDay =
  fmt.format(guide.data.date) === fmt.format(guide.data.updatedDate);
---

<GuidesLayout
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  guide={guide.data.title}
  date={guide.data.date}
  updatedDate={guide.data.updatedDate}
>
  <article class="guide">
    <header>
      <h1 class="doc-title">{guide.data.title}</h1>
      {
        guide.data.description && (
          <p class="doc-lede">{guide.data.description}</p>
        )
      }
      <div class="doc-meta">
        <dl>
          <div>
            <dt>{t(UiKey["guides.createdAt"])}</dt>
            <dd>
              <time datetime={guide.data.date.toISOString()}>
                {fmt.format(guide.data.date)}
              </time>
            </dd>
          </div>
          {
            !sameDay && (
              <div>
                <dt>{t(UiKey["guides.updatedAt"])}</dt>
                <dd>
                  <time datetime={guide.data.updatedDate.toISOString()}>
                    {fmt.format(guide.data.updatedDate)}
                  </time>
                </dd>
              </div>
            )
          }
        </dl>
        <span
          >{
            t(UiKey["guides.readingTime"]).replace("{n}", String(minutes))
          }</span
        >
      </div>
    </header>

    <div class="doc-grid">
      <Contents headings={headings} label={t(UiKey["docs.contents"])} />
      <div class="markdown-body">
        <Content />
      </div>
    </div>
  </article>

  {
    next && (
      <nav class="guide-next page-break" aria-label={t(UiKey["guides.next"])}>
        <a href={`/${lang}/guides/${next.slug.slice(0, -2)}`}>
          <span class="guide-next__label">{t(UiKey["guides.next"])}</span>
          <span class="guide-next__title">
            {next.data.title}
            <ArrowRight size={28} aria-hidden="true" />
          </span>
          {next.data.description && (
            <span class="guide-next__desc">{next.data.description}</span>
          )}
        </a>
      </nav>
    )
  }

  <section class="guide-end" aria-labelledby="guide-end-title">
    <figure class="guide-end__photo">
      <span class="guide-end__tape" aria-hidden="true"></span>
      <Image src={MeImage} alt="" width={240} loading="lazy" />
    </figure>
    <div class="guide-end__body">
      <h2 id="guide-end-title">{t(UiKey["guides.contact.title"])}</h2>
      <p>{t(UiKey["guides.contact.description"])}</p>
      <div class="guide-end__actions">
        <Button href={`mailto:${email}`} target="_self">
          <Mail size={18} />
          {t(UiKey["portfolio.contact.sendEmail"])}
        </Button>
        <Button type="Outlined" href={buyMeACoffee}>
          <Coffee size={18} />
          {t(UiKey["guides.contact.buyMeACoffee"])}
        </Button>
      </div>
    </div>
  </section>
</GuidesLayout>

<style>
  .guide-next {
    position: relative;
    margin-top: clamp(64px, 9vw, 112px);
    padding-top: clamp(40px, 6vw, 64px);
  }
  .guide-next a {
    display: grid;
    gap: 10px;
    max-width: 60ch;
    color: inherit;
  }
  .guide-next__label {
    font-weight: 600;
    color: var(--text-secondary);
  }
  .guide-next__title {
    max-width: 22ch;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .guide-next__title :global(svg) {
    display: inline;
    margin-left: 10px;
    vertical-align: -0.12em;
    transition: transform var(--dur) var(--ease-out);
  }
  .guide-next a:hover .guide-next__title {
    color: var(--pencil);
  }
  .guide-next a:hover .guide-next__title :global(svg) {
    transform: translateX(6px);
  }
  .guide-next__desc {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* A taped-in portrait and a short note: the guide is signed off */
  .guide-end {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    max-width: 860px;
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }
  .guide-end__photo {
    position: relative;
    width: clamp(112px, 16vw, 168px);
    margin: 0;
    padding: 8px 8px 22px;
    background: var(--sheet);
    box-shadow: var(--shadow-md);
    transform: rotate(-2.5deg);
  }
  .guide-end__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }
  .guide-end__tape {
    position: absolute;
    top: -12px;
    left: 50%;
    z-index: 1;
    width: 72px;
    height: 24px;
    background: var(--tape);
    border-inline: 1px solid var(--tape-edge);
    transform: translateX(-50%) rotate(3deg);
  }
  .guide-end h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .guide-end p {
    max-width: 44ch;
    margin-top: 10px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }
  .guide-end__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 600px) {
    .guide-end {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .guide-next__title :global(svg) {
      transition: none;
    }
  }
</style>
