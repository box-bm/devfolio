---
import GuidesLayout from "@layouts/Guides.astro";
import Contents from "@components/docs/Contents.astro";
import Button from "@components/Button.astro";
import SignOff from "@components/docs/SignOff.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { LANG_CODES } from "@i18n/langs";
import { UiKey } from "@i18n/ui";
import {
  getGuides,
  guideDateFormat,
  guideHref,
  guideSlug,
  readingMinutes,
} from "@utils/guides";
import { ArrowRight, Coffee, Mail } from "@lucide/astro";
import { buyMeACoffee, email } from "@constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return (
    await Promise.all(
      LANG_CODES.map(async (lang) => {
        const guides = await getGuides(lang);
        return guides.map((guide, i) => ({
          params: { lang, slug: guideSlug(guide) },
          // The next older guide in this language, wrapping to the newest.
          props: {
            guide,
            next:
              guides.length > 1 ? guides[(i + 1) % guides.length] : undefined,
          },
        }));
      }),
    )
  ).flat();
}

const { guide, next } = Astro.props;
const { Content, headings } = await guide.render();

const fmt = guideDateFormat(lang);
const minutes = readingMinutes(guide.body);

const sameDay =
  fmt.format(guide.data.date) === fmt.format(guide.data.updatedDate);
---

<GuidesLayout
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  guide={guide.data.title}
  date={guide.data.date}
  updatedDate={guide.data.updatedDate}
>
  <article class="guide">
    <header>
      <h1 class="doc-title">{guide.data.title}</h1>
      {
        guide.data.description && (
          <p class="doc-lede">{guide.data.description}</p>
        )
      }
      <div class="doc-meta">
        <dl>
          <div>
            <dt>{t(UiKey["guides.createdAt"])}</dt>
            <dd>
              <time datetime={guide.data.date.toISOString()}>
                {fmt.format(guide.data.date)}
              </time>
            </dd>
          </div>
          {
            !sameDay && (
              <div>
                <dt>{t(UiKey["guides.updatedAt"])}</dt>
                <dd>
                  <time datetime={guide.data.updatedDate.toISOString()}>
                    {fmt.format(guide.data.updatedDate)}
                  </time>
                </dd>
              </div>
            )
          }
        </dl>
        <span>{t(UiKey["guides.readingTime"], { n: minutes })}</span>
      </div>
    </header>

    <div class="doc-grid">
      <Contents headings={headings} label={t(UiKey["docs.contents"])} />
      <div class="markdown-body">
        <Content />
      </div>
    </div>
  </article>

  {
    next && (
      <nav class="guide-next page-break" aria-label={t(UiKey["guides.next"])}>
        <a href={guideHref(next, lang)}>
          <span class="guide-next__label">{t(UiKey["guides.next"])}</span>
          <span class="guide-next__title">
            {next.data.title}
            <ArrowRight size={28} aria-hidden="true" />
          </span>
          {next.data.description && (
            <span class="guide-next__desc">{next.data.description}</span>
          )}
        </a>
      </nav>
    )
  }

  <SignOff
    id="guide-end-title"
    title={t(UiKey["guides.contact.title"])}
    description={t(UiKey["guides.contact.description"])}
  >
    <Button href={`mailto:${email}`} target="_self">
      <Mail size={18} />
      {t(UiKey["portfolio.contact.sendEmail"])}
    </Button>
    <Button type="Outlined" href={buyMeACoffee}>
      <Coffee size={18} />
      {t(UiKey["guides.contact.buyMeACoffee"])}
    </Button>
  </SignOff>
</GuidesLayout>

<style>
  .guide-next {
    position: relative;
    margin-top: clamp(64px, 9vw, 112px);
    padding-top: clamp(40px, 6vw, 64px);
  }
  .guide-next a {
    display: grid;
    gap: 10px;
    max-width: 60ch;
    color: inherit;
  }
  .guide-next__label {
    font-weight: 600;
    color: var(--text-secondary);
  }
  .guide-next__title {
    max-width: 22ch;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .guide-next__title :global(svg) {
    display: inline;
    margin-left: 10px;
    vertical-align: -0.12em;
    transition: transform var(--dur) var(--ease-out);
  }
  .guide-next a:hover .guide-next__title {
    color: var(--pencil);
  }
  .guide-next a:hover .guide-next__title :global(svg) {
    transform: translateX(6px);
  }
  .guide-next__desc {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-next__title :global(svg) {
      transition: none;
    }
  }
</style>
