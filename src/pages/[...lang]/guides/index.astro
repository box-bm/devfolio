---
import GuidesLayout from "@layouts/Guides.astro";
import { ArrowRight } from "@lucide/astro";
import { UiKey } from "@i18n/ui";
import { LANG_CODES } from "@i18n/langs";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import {
  getGuides,
  guideDateFormat,
  guideHref,
  readingMinutes,
} from "@utils/guides";
import { email } from "@constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const getStaticPaths = () => {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
};

const guides = await getGuides(lang);
const fmt = guideDateFormat(lang);
---

<GuidesLayout>
  <header class="guides-head">
    <h1 class="doc-title doc-title--index">{t(UiKey["guides.title"])}</h1>
    <p class="doc-lede">{t(UiKey["guides.subtitle"])}</p>
  </header>

  {
    guides.length === 0 ? (
      <p class="guides-empty">{t(UiKey["guides.empty"])}</p>
    ) : (
      <ol class="ruled guides-list">
        {guides.map((guide) => (
          <li data-reveal>
            <a class="ruled-link" href={guideHref(guide, lang)}>
              <span class="ruled-link__meta">
                <time datetime={guide.data.date.toISOString()}>
                  {fmt.format(guide.data.date)}
                </time>
                {" · "}
                {t(UiKey["guides.readingTime"], {
                  n: readingMinutes(guide.body),
                })}
              </span>
              <span class="ruled-link__title">{guide.data.title}</span>
              {guide.data.description && (
                <span class="ruled-link__desc">{guide.data.description}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    )
  }

  <section class="guides-contact page-break" aria-labelledby="guides-contact">
    <h2 id="guides-contact">{t(UiKey["guides.contact.title"])}</h2>
    <p>{t(UiKey["guides.contact.description"])}</p>
    <a class="guides-contact__email" href={`mailto:${email}`}>
      {email}
      <ArrowRight size={22} aria-hidden="true" />
    </a>
  </section>
</GuidesLayout>

<style>
  .guides-list {
    max-width: 860px;
    margin-top: clamp(48px, 7vw, 88px);
  }
  .guides-empty {
    margin-top: 48px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }
  .guides-contact {
    margin-top: clamp(72px, 10vw, 128px);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .guides-contact h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .guides-contact p {
    max-width: 44ch;
    margin-top: 12px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }
  .guides-contact__email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--pencil);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .guides-contact__email:hover {
    text-decoration-thickness: 4px;
  }
</style>
