---
import LegalLayout from "@layouts/Legal.astro";
import LegalDocument from "@components/docs/LegalDocument.astro";
import { getCollection } from "astro:content";
import type { Lang } from "@i18n/langs";
import { legalSlug } from "@utils/legal";

export async function getStaticPaths() {
  const docs = await getCollection("legal");

  return docs.map((doc) => ({
    props: { doc },
    params: {
      lang: doc.data.lang,
      slug: legalSlug(doc),
    },
  }));
}

const { doc } = Astro.props;
---

<LegalLayout
  title={`${doc.data.title} · ${doc.data.app}`}
  document={doc.data.title}
>
  <LegalDocument doc={doc} lang={doc.data.lang as Lang} />
</LegalLayout>
