---
import LegalLayout from "@layouts/Legal.astro";
import { UiKey } from "@i18n/ui";
import { LANG_CODES, languages, type Lang } from "@i18n/langs";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getCollection } from "astro:content";
import LegalQuestions from "@components/docs/LegalQuestions.astro";
import { legalDateFormat, legalSlug } from "@utils/legal";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const getStaticPaths = () => {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
};

const allDocs = await getCollection("legal");
const fmt = legalDateFormat(lang);

const apps = Array.from(new Set(allDocs.map((d) => d.data.app))).map(
  (appName) => {
    // This page's language first, then the rest.
    const docs = allDocs
      .filter((d) => d.data.app === appName)
      .sort(
        (a, b) => Number(b.data.lang === lang) - Number(a.data.lang === lang),
      );
    const primary = docs[0];
    return {
      appName,
      version: primary.data.version,
      effectiveDate: primary.data.effectiveDate,
      docs: docs.map((doc) => ({
        title: doc.data.title,
        lang: doc.data.lang as Lang,
        slug: legalSlug(doc),
      })),
    };
  },
);
---

<LegalLayout>
  <header>
    <h1 class="doc-title doc-title--index">{t(UiKey["legal.title"])}</h1>
    <p class="doc-lede">{t(UiKey["legal.subtitle"])}</p>
  </header>

  <div class="legal-apps">
    {
      apps.map((app) => (
        <section class="legal-app" aria-labelledby={`app-${app.docs[0].slug}`}>
          <div class="legal-app__head">
            <h2 id={`app-${app.docs[0].slug}`}>{app.appName}</h2>
            <dl class="legal-app__meta">
              <div>
                <dt>{t(UiKey["legal.version"])}</dt>
                <dd>{app.version}</dd>
              </div>
              {app.effectiveDate && (
                <div>
                  <dt>{t(UiKey["legal.effectiveDate"])}</dt>
                  <dd>{fmt.format(app.effectiveDate)}</dd>
                </div>
              )}
            </dl>
          </div>
          <ul class="ruled">
            {app.docs.map((doc) => (
              <li>
                <a
                  class="ruled-link legal-row"
                  href={`/${doc.lang}/legal/${doc.slug}`}
                  hreflang={doc.lang}
                  lang={doc.lang}
                >
                  <span class="ruled-link__title">{doc.title}</span>
                  <span class="ruled-link__meta">{languages[doc.lang]}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <LegalQuestions
    lang={lang}
    maxWidth="60ch"
    marginTop="clamp(64px, 9vw, 112px)"
  />
</LegalLayout>

<style>
  .legal-apps {
    display: grid;
    gap: clamp(48px, 7vw, 80px);
    max-width: 960px;
    margin-top: clamp(48px, 7vw, 88px);
  }
  .legal-app {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(20px, 5vw, 64px);
    align-items: start;
  }
  .legal-app h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .legal-app__meta {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    font-size: 0.95rem;
    font-variant-numeric: proportional-nums;
  }
  .legal-app__meta div {
    display: flex;
    gap: 8px;
  }
  .legal-app__meta dt {
    color: var(--text-secondary);
  }
  .legal-app__meta dd {
    margin: 0;
    font-weight: 600;
  }
  .legal-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding-block: 20px;
  }
  .legal-row .ruled-link__title {
    font-size: 1.25rem;
  }
  @media (max-width: 760px) {
    .legal-app {
      grid-template-columns: 1fr;
    }
  }
</style>
