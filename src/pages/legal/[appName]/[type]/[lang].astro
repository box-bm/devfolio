---
/* Store listings link these URLs; keep them, render the same document. */
import { getCollection } from "astro:content";
import LegalLayout from "@layouts/Legal.astro";
import LegalDocument from "@components/docs/LegalDocument.astro";
import type { Lang } from "@i18n/langs";

export async function getStaticPaths() {
  const policies = await getCollection("legal");

  return policies.map((policy) => {
    const { type, lang } = policy.data;
    const [appName] = policy.slug.split("/");

    return {
      params: {
        appName: appName.toLowerCase(),
        type,
        lang,
      },
      props: {
        policy,
      },
    };
  });
}

const { policy } = Astro.props;
const lang = policy.data.lang as Lang;
---

<LegalLayout
  title={`${policy.data.title} · ${policy.data.app}`}
  document={policy.data.title}
  lang={lang}
>
  <LegalDocument doc={policy} lang={lang} />
</LegalLayout>
