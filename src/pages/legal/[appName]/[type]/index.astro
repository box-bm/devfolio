---
// Old language picker for one document; the English document is the
// default, and it links to the legal index for the Spanish version.
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const policies = await getCollection("legal");
  const seen = new Set<string>();
  return policies.flatMap((policy) => {
    const appName = policy.slug.split("/")[0].toLowerCase();
    const key = `${appName}/${policy.data.type}`;
    if (seen.has(key)) return [];
    seen.add(key);
    return [{ params: { appName, type: policy.data.type } }];
  });
}

const { appName, type } = Astro.params;
return Astro.redirect(`/en/legal/${appName}/${type}`);
---
