---
// Old per-app picker; send visitors to the legal index.
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const policies = await getCollection("legal");
  const apps = new Set(policies.map((p) => p.slug.split("/")[0].toLowerCase()));
  return [...apps].map((appName) => ({ params: { appName } }));
}

return Astro.redirect("/en/legal");
---
