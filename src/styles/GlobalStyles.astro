<style is:global>
  /* ================================================================
     DESIGN TOKENS — monochrome glass + a single electric-blue accent
     Legacy variable names (--accent-primary, --neutral-*, --text-*)
     are kept and mapped so legal / markdown / dropdown stay intact.
     ================================================================ */
  :root {
    color-scheme: light;

    /* Fonts — Geist (UI/headings) + JetBrains Mono (annotations, tags, code) */
    --font-display: "Geist", "Helvetica Neue", Helvetica, system-ui, sans-serif;
    --font-body: "Geist", "Helvetica Neue", Helvetica, system-ui, sans-serif;
    --font-mono:
      "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;

    /* Base — cool, light (blueprint hairline system) */
    --bg: #f5f4f2;
    --bg-deep: #ecebe8;
    --surface: rgba(255, 255, 255, 0.74);
    --surface-2: #ffffff;
    --surface-3: #f0eee9;
    --line: #dcd9d4;
    --line-soft: rgba(130, 126, 120, 0.26);
    --line-strong: #c9c5be;

    /* Text */
    --text-primary: #17181a;
    --text-secondary: #5e6469;
    --text-tertiary: #83898d;
    --text-inverse: #17181a;

    /* Accents — sand (primary) + corinto (secondary), never neon */
    --olive: #d9a05b;
    --olive-hover: #e4af6d;
    --olive-ink: #8a5a1e;
    --on-accent: #17181a;
    --corinto: #8a4436;
    --corinto-ink: #8a4436;

    --accent: var(--olive-ink);
    --accent-strong: var(--olive-hover);
    --accent-soft: rgba(217, 160, 91, 0.12);
    --accent-glow: rgba(217, 160, 91, 0.14);
    --accent-contrast: var(--on-accent);

    /* Ambient glow */
    --glow-2: rgba(222, 155, 134, 0.08);

    /* Glass / acrylic */
    --glass-bg: var(--surface);
    --glass-bg-strong: rgba(255, 255, 255, 0.88);
    --glass-border: var(--line);
    --glass-highlight: rgba(255, 255, 255, 0.7);
    --glass-blur: 20px;

    /* Shadows */
    --shadow-sm: 0 1px 0 rgba(23, 24, 26, 0.04);
    --shadow-md: 0 10px 30px rgba(23, 24, 26, 0.08);
    --shadow-lg: 0 18px 48px rgba(23, 24, 26, 0.12);
    --shadow-accent: 0 10px 30px rgba(217, 160, 91, 0.22);
    --shadow-glow: var(--shadow-accent);

    /* Radii — tags -> buttons -> cards -> hero frames */
    --radius-sm: 6px;
    --radius: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-pill: 999px;

    /* Motion — single restrained ease, no bounce */
    --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
    --ease-spring: cubic-bezier(0.22, 0.61, 0.36, 1);
    --dur-fast: 250ms;
    --dur: 350ms;
    --dur-slow: 700ms;

    /* Legacy aliases (do not remove — markdown/legal/breadcrumb depend on these) */
    --neutral-white: var(--surface-2);
    --neutral-light: var(--surface-3);
    --neutral-medium: var(--line-strong);
    --neutral-light-gray: var(--surface-3);
    --neutral-dark: #2b2b2b;
    --neutral-black: #17181a;
    --accent-primary: var(--accent);
    --accent-dark: var(--corinto-ink);
    --accent-darkest: #5c1a24;
  }

  [data-theme="dark"] {
    color-scheme: dark;

    /* Base — cool, near-dark */
    --bg: #15171a;
    --bg-deep: #101316;
    --surface: rgba(30, 33, 37, 0.7);
    --surface-2: #1e2125;
    --surface-3: #24272b;
    --line: #2c3034;
    --line-soft: rgba(44, 48, 52, 0.5);
    --line-strong: #3a3f45;

    --text-primary: #ecedee;
    --text-secondary: #949ba3;
    --text-tertiary: #6e747c;
    --text-inverse: #17181a;

    --olive-ink: #e6b778;
    --corinto-ink: #de9b86;

    --accent: var(--olive-ink);
    --accent-strong: var(--olive-hover);
    --accent-soft: rgba(217, 160, 91, 0.14);
    --accent-glow: rgba(217, 160, 91, 0.13);
    --accent-contrast: var(--on-accent);

    --glow-2: rgba(222, 155, 134, 0.08);

    --glass-bg: var(--surface);
    --glass-bg-strong: rgba(30, 33, 37, 0.88);
    --glass-border: var(--line);
    --glass-highlight: rgba(236, 237, 238, 0.06);

    --shadow-sm: 0 1px 0 rgba(236, 237, 238, 0.03);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.28);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.4);
    --shadow-accent: 0 10px 30px rgba(217, 160, 91, 0.22);
    --shadow-glow: var(--shadow-accent);

    --neutral-dark: #e5e5e5;
    --neutral-black: #ecedee;
    --accent-darkest: #de9b86;
  }

  /* ================================================================
     RESET & BASE
     ================================================================ */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg);
    overflow-x: hidden;
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  main {
    flex-grow: 1;
    width: 100%;
  }

  /* document pages (guides / legal) clear the fixed header */
  .doc-main {
    padding-top: 104px;
    padding-inline: 16px;
  }

  /* Smooth theme transition for surfaces & text only (not transforms) */
  a,
  button,
  .card,
  .chip,
  header,
  footer,
  input,
  textarea,
  section {
    transition:
      color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p,
  figure,
  blockquote,
  ul,
  ol {
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  .h1,
  .h2,
  .h3,
  .h4 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  h1,
  .h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  h2,
  .h2 {
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
  }
  h3,
  .h3 {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  h4,
  .h4 {
    font-size: 1.05rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  p,
  span,
  li,
  a,
  label,
  input,
  textarea,
  button {
    letter-spacing: 0;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .body-large {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }
  .body-small {
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .caption {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  ::selection {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  img {
    max-width: 100%;
    display: block;
  }

  /* ================================================================
     LAYOUT HELPERS
     ================================================================ */
  .container {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 40px);
  }

  /* Small corner-bracket marks — viewfinder/crop-mark signature detail */
  .corner-marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .corner-marks span {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
  }
  .corner-marks span:nth-child(1) {
    top: -1px;
    left: -1px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-marks span:nth-child(2) {
    top: -1px;
    right: -1px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .corner-marks span:nth-child(3) {
    bottom: -1px;
    left: -1px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .corner-marks span:nth-child(4) {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  .corner-marks.corner-marks--sm span {
    width: 8px;
    height: 8px;
  }
  .corner-marks--two span:nth-child(2),
  .corner-marks--two span:nth-child(3) {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px;
    width: 100%;
  }

  .small-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .primary-text,
  .accent-text {
    color: var(--accent);
  }

  /* Muted headline span — pairs with a solid-ink lead line in hero/heading copy */
  .gradient-text {
    color: var(--text-secondary);
  }

  /* Mono eyebrow label — plain uppercase caption, no decoration */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .eyebrow.is-accent {
    color: var(--accent);
  }

  /* ================================================================
     GLASS SURFACE
     ================================================================ */
  .glass {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow:
      var(--shadow-md),
      inset 0 1px 0 var(--glass-highlight);
  }

  /* ================================================================
     SCROLL REVEAL (driven by Motion.astro IntersectionObserver)
     ================================================================ */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  [data-reveal="left"] {
    transform: translateX(-36px);
  }
  [data-reveal="right"] {
    transform: translateX(36px);
  }
  [data-reveal="scale"] {
    transform: scale(0.92);
  }
  [data-reveal="blur"] {
    filter: blur(12px);
    transform: translateY(20px);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* ================================================================
     SECTION RHYTHM
     ================================================================ */
  .section {
    position: relative;
    padding-block: clamp(72px, 12vw, 140px);
    scroll-margin-top: 84px;
  }

  /* ================================================================
     CUSTOM SCROLLBAR
     ================================================================ */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  *::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  *::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: content-box;
  }
  *::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
    background-clip: content-box;
  }

  /* ================================================================
     VIEW TRANSITIONS
     ================================================================ */
  @view-transition {
    navigation: auto;
  }

  /* ================================================================
     REDUCED MOTION
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
