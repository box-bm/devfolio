<style is:global>
  /* ================================================
     Markdown content: guides, blog posts and legal documents.
     Same paper, graphite and blue pencil as the rest of the
     sketchbook; set for long reading, so no handwriting here.
     The one exception is .pencil-note, a margin note in the pencil
     hand that blog posts write as <aside class="pencil-note">.
     ================================================ */

  .markdown-body {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }

  /* The page renders the title from frontmatter, so the markdown's own
     opening H1 would repeat it. */
  .markdown-body > h1:first-child {
    display: none;
  }

  /* A guide's own "Table of Contents" section repeats the page's contents
     list (components/docs/Contents.astro), so it is hidden. */
  .doc-grid #table-of-contents,
  .doc-grid #table-of-contents + :is(ul, ol),
  .doc-grid #tabla-de-contenidos,
  .doc-grid #tabla-de-contenidos + :is(ul, ol) {
    display: none;
  }

  /* ---------- Margin note (blog) ---------- */
  .markdown-body .pencil-note {
    margin: 0 0 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--pencil);
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--pencil);
  }
  .markdown-body .pencil-note > :last-child {
    margin-bottom: 0;
  }

  /* ---------- Headings ---------- */
  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3,
  .markdown-body h4,
  .markdown-body h5,
  .markdown-body h6 {
    color: var(--text-primary);
    font-family: var(--font-display);
    text-wrap: balance;
    scroll-margin-top: 96px;
  }
  .markdown-body h1,
  .markdown-body h2 {
    margin: 3rem 0 1rem;
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .markdown-body h3 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .markdown-body h4,
  .markdown-body h5,
  .markdown-body h6 {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
  }

  /* ---------- Text ---------- */
  .markdown-body p {
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    text-wrap: pretty;
  }
  .markdown-body strong {
    font-weight: 700;
    color: var(--text-primary);
  }
  .markdown-body em {
    font-style: italic;
    color: var(--text-primary);
  }
  .markdown-body del {
    color: var(--text-secondary);
  }

  .markdown-body a:not(.btn) {
    color: var(--pencil);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .markdown-body a:not(.btn):hover {
    text-decoration-thickness: 3px;
  }

  /* ---------- Lists ---------- */
  .markdown-body ul,
  .markdown-body ol {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-primary);
  }
  .markdown-body ul {
    list-style-type: disc;
  }
  .markdown-body ul ul {
    list-style-type: circle;
  }
  .markdown-body ol {
    list-style-type: decimal;
  }
  .markdown-body ol ol {
    list-style-type: lower-alpha;
  }
  .markdown-body li ul,
  .markdown-body li ol {
    margin: 0.375rem 0 0;
  }
  .markdown-body li {
    margin-bottom: 0.375rem;
    padding-left: 0.25rem;
  }
  .markdown-body li::marker {
    color: var(--pencil);
    font-weight: 700;
    font-variant-numeric: proportional-nums;
  }

  /* ---------- Code ---------- */
  .markdown-body code:not(pre code) {
    padding: 0.1em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text-primary);
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
  }

  /* Shiki emits --shiki-light / --shiki-dark; switch by data-theme. */
  .markdown-body pre,
  .markdown-body pre span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }
  [data-theme="dark"] .markdown-body pre,
  [data-theme="dark"] .markdown-body pre span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  .markdown-body pre {
    margin: 0 0 1.5rem;
    padding: 1.125rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .markdown-body pre code {
    padding: 0;
    font-size: inherit;
    background: none !important;
    border: none;
    white-space: pre;
  }

  /* ---------- Blockquote: a note on a lighter slip of paper ---------- */
  .markdown-body blockquote {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    color: var(--text-primary);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .markdown-body blockquote > :last-child {
    margin-bottom: 0;
  }

  /* ---------- Tables: ruled, no zebra ---------- */
  .markdown-body table {
    display: block;
    width: 100%;
    margin: 0 0 1.5rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .markdown-body thead {
    border-bottom: 2px solid var(--text-primary);
  }
  .markdown-body th {
    padding: 0.625rem 1rem 0.625rem 0;
    font-weight: 700;
    text-align: left;
    white-space: nowrap;
  }
  .markdown-body td {
    padding: 0.625rem 1rem 0.625rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  /* ---------- Rule: a perforation ---------- */
  .markdown-body hr {
    height: 4px;
    margin: 2.5rem 0;
    border: none;
    background: radial-gradient(
        circle,
        var(--line-strong) 1.6px,
        transparent 2px
      )
      0 0 / 12px 4px repeat-x;
  }

  /* ---------- Images: screenshots taped in as sheets ---------- */
  .markdown-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    padding: 10px;
    background: var(--sheet);
    box-shadow: var(--shadow-md);
  }

  /* ---------- Details ---------- */
  .markdown-body details {
    margin: 0 0 1.25rem;
    padding: 0.625rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .markdown-body summary {
    min-height: 32px;
    font-weight: 700;
    cursor: pointer;
  }
  .markdown-body details[open] summary {
    margin-bottom: 0.75rem;
  }
</style>
